# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- LLM provider ---
GROQ_API_KEY=

# --- Barge-in / VAD ---
# "silero" (primary) or "webrtc" (lighter fallback) — see CLAUDE.md "Open questions".
VAD_BACKEND=silero
# Consecutive ms of detected speech before a barge-in fires (avoids false
# triggers on breaths/coughs).
VAD_SPEECH_THRESHOLD_MS=250

# --- STT ---
# faster-whisper model size — only invoked after a barge-in fires, not on
# the hot interrupt-detection path, so latency here matters less than VAD's.
WHISPER_MODEL_SIZE=base

# --- TTS ---
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx

# --- App ---
LOG_LEVEL=INFO
