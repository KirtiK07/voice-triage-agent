# Secrets / env
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / lint artifacts
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local model weights/caches (Whisper, TTS, etc.) — large, regenerated on
# first run via the model library's own download/cache mechanism, not
# hand-authored.
models/
*.onnx
*.bin
*.ckpt
.cache/

# Audio artifacts from local runs/tests — not source
*.wav
*.mp3
*.flac
recordings/

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Demo recordings — kept locally for the user's own reference only, never
# committed/deployed (barge-in especially needs to be *seen* to be
# believed, but the recording itself stays private, not part of the repo).
docs/demo.gif
docs/demo.mp4
*.demo.mp4
